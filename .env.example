# --- Required for ingestion + dense retrieval ---
OPENAI_API_KEY=sk-...

# --- Required for grounded answers (Claude primary) and reranking (Cohere) ---
# Unit tests do NOT need these (clients are injectable); real `ask`/`hybrid_rerank` runs do.
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=...

# --- Optional overrides (ACCURAG_ prefix maps to Settings fields) ---
ACCURAG_EMBED_MODEL=text-embedding-3-large
ACCURAG_COLLECTION=accurag_dense
